# Supabase (Projekt-Einstellungen -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Öffentliche URL der Webseite (für Links in automatischen E-Mails, z.B. Newsletter)
NEXT_PUBLIC_SITE_URL=https://novidom-immo.ch

# Resend (E-Mail-Versand für Formulare)
RESEND_API_KEY=
LEADS_EMAIL_TO=beratung@novidom-immo.ch
LEADS_EMAIL_FROM="NoviDom Immo <onboarding@resend.dev>"

# Optional: WhatsApp-Nummer für den schwebenden Kontakt-Button
# Format ohne "+" oder Leerzeichen, z.B. 41791234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: Cal.com-Link für die Online-Terminbuchung (Bewertungsgespräch)
# Kostenloses Konto auf cal.com erstellen, dann z.B. novidom/beratung
NEXT_PUBLIC_CAL_LINK=

# Optional: eigener Cal.com-Link für Besichtigungstermine auf den Objektseiten
# (andere Dauer/Ablauf als ein Bewertungsgespräch). Ohne diesen Wert wird
# NEXT_PUBLIC_CAL_LINK auch für Besichtigungen verwendet.
NEXT_PUBLIC_CAL_LINK_VIEWING=

# Optional: interne E-Mail-Adresse von hypotheken-analyse.ch (Kim & Ruedi),
# an die Admin-Leads mit Finanzierungsbedarf per Klick weitergeleitet werden
# koennen (nur intern im Admin-Bereich sichtbar, nicht auf der Webseite).
NEXT_PUBLIC_PARTNER_REFERRAL_EMAIL=

# Kein Env-Var, sondern ein Datei-Hinweis: Ratgeber-PDF (Export aus dem
# gelieferten Word-Dokument) hier ablegen, damit er automatisch der
# Bestätigungsmail bei Ratgeber-Anfragen angehängt wird:
# public/downloads/ratgeber-novidom-immo.pdf

# Optional: für den automatischen Wochenreport an Verkaufskunden.
# ACHTUNG: Service-Role-Key ist geheim - nur in Vercel eintragen, nie öffentlich!
# Zu finden in Supabase unter Project Settings -> API Keys -> service_role / Secret key
SUPABASE_SERVICE_ROLE_KEY=
# Beliebiger langer Zufallswert - schützt die Cron-Route vor fremden Aufrufen
CRON_SECRET=
